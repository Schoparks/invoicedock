# 本地使用可不创建 .env。线上部署复制后修改，并 chmod 600 .env。
INVOICE_MODE=production
INVOICE_ALLOWED_HOSTS=invoices.example.com,127.0.0.1,localhost
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
INVOICE_DATA_DIR=/srv/invoice-desk/data
PORT=8765
INVOICE_MAIL_WORKER=1
INVOICE_MAIL_POLL_SECONDS=60
# 留空时自动在数据目录建立 secret.key；必须随服务器数据一起备份。
# 若设置环境密钥，需另外妥善保存它。生成方式见 DEPLOY.md。
# INVOICE_SECRET_KEY=
CLAIM_LEGACY_DATA=false

# 自有域名收票：上游以 SMTP 信封收件地址签名提交原邮件；不要将此密钥交给前端。
# INVOICE_RECEIPT_DOMAIN=receipts.example.com
# INVOICE_INBOUND_SECRET=
INVOICE_INBOUND_WORKER=1
